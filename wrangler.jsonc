  //     "bucket_name": "fixmyform-videos"
  //   }
  // ],
  
  // Vectorize for reference pose database
  // "vectorize": [
  //   {
  //     "binding": "VECTORIZE_INDEX",
  //     "index_name": "reference-poses"
  //   }
  // ],
  
  // D1 for metadata storage
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "fixmyform-db",
  //     "database_id": "your-database-id-here"
